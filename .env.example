# Dipakai backend (src/server)
DATABASE_URL=postgresql://user:password@your-neon-host/dbname?sslmode=require
PUBLIC_APP_URL=http://localhost:5173
NODE_ENV=development
PORT=3000

# Secret Better Auth (min 32 karakter, generate: openssl rand -base64 32)
# WAJIB sama dengan BETTER_AUTH_SECRET di Vercel agar session valid di production.
BETTER_AUTH_SECRET=

# API key dashboard Better Auth (https://dash.better-auth.com -> Settings)
# Dipakai plugin dash() untuk koneksi ke dash.better-auth.com.
BETTER_AUTH_API_KEY=

# Discord OAuth (https://discord.com/developers/applications)
# Redirect/callback URL aplikasi di Discord Developer Portal:
#   dev  -> http://localhost:3000/api/auth/callback/discord
#   prod -> https://<domain>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
